# Bank 3: a bank on Temenos T24 / Transact core banking, with its
# application records loaded into a graph more or less as they are.
#
# Sources and names (T24 application -> vertex):
#   CUSTOMER              -> CUSTOMER
#   ACCOUNT               -> ACCOUNT
#   FUNDS.TRANSFER        -> FUNDS_TRANSFER
#   TELLER                -> TELLER (cash deposits and withdrawals at a branch)
#   STMT.ENTRY            -> STMT_ENTRY (ledger postings)
#   BENEFICIARY           -> BENEFICIARY (internet-banking saved payees)
#   CARD.ISSUE            -> CARD_ISSUE
#   EB.EXTERNAL.USER      -> EB_EXTERNAL_USER (internet-banking user)
#   F.PROTOCOL            -> PROTOCOL (sign-on and activity log)
#   DEPT.ACCT.OFFICER     -> DEPT_ACCT_OFFICER
#   COMPANY               -> COMPANY (the T24 branch/company, CO.CODE)
# Field names are T24's own with "." replaced by "_" (DEBIT.ACCT.NO ->
# DEBIT_ACCT_NO). Multi-value fields that point at other records
# (JOINT.HOLDER, DEBIT.ACCT.NO) are edges. Built for testing schema
# mapping; Temenos does not publish a graph model.
#
# What this schema tests:
#   - Upper-case names and core-banking codes instead of words:
#     TRANSACTION_TYPE "AC" (account transfer), "OT" (outward payment),
#     "ACCD"/"ACCW" in TELLER (cash deposit/withdrawal); CATEGORY is a
#     numeric product code (1001 current, 6001 savings); POSTING_RESTRICT
#     is a numeric block code; RECORD_STATUS "INAU" means unauthorised.
#   - Dates as strings: YYYYMMDD (OPENING_DATE, PROCESSING_DATE) and
#     YYMMDDHHMM (DATE_TIME, the audit stamp, the only time-of-day).
#   - CUSTOMER and DEPT_ACCT_OFFICER have INT primary ids.
#   - Three money-movement types: FUNDS_TRANSFER and TELLER are both
#     transactions; STMT_ENTRY is the ledger and should not be picked.
#   - Joint accounts: an owner edge plus a JOINT_HOLDER edge.
#   - Logins are PROTOCOL records keyed by user and terminal (no IP
#     vertex: TERMINAL_ID and IP_ADDRESS are attributes).
#   - KYC is "YES"/"NO"; AML risk is CALC_RISK_CLASS / MANUAL_RISK_CLASS.
#   - No cases: an account is "under investigation" only by
#     POSTING_RESTRICT code 25 (fraud block) set on it.
#
# Expected mapping (ground truth):
#   Person                   exact        CUSTOMER
#   Account                  exact        ACCOUNT
#   Transaction              exact        FUNDS_TRANSFER and TELLER (not STMT_ENTRY)
#   Beneficiary              exact        BENEFICIARY
#   Card                     exact        CARD_ISSUE
#   LoginEvent               exact        PROTOCOL where APPLICATION = "SIGN.ON"
#   Device                   approximate  PROTOCOL.TERMINAL_ID (attribute)
#   IPAddress                approximate  PROTOCOL.IP_ADDRESS (attribute)
#   Merchant, InvestigationCase   unmapped
#   OWNS                     exact        ACCOUNT_CUSTOMER and JOINT_HOLDER (both CUSTOMER <- ACCOUNT)
#   INITIATED                exact        reverse_FT_DEBIT_ACCT_NO; TT_ACCOUNT_1 where DR_CR_MARKER = "DEBIT"
#   PAYS_TO_ACCOUNT          exact        FT_CREDIT_ACCT_NO; TT_ACCOUNT_1 where DR_CR_MARKER = "CREDIT"
#   PAYS                     exact        FT_BENEFICIARY
#   HOLDS                    exact        reverse_CARD_ISSUE_ACCOUNT
#   LOGGED_IN                approximate  PROTOCOL -> EB_EXTERNAL_USER -> CUSTOMER -> ACCOUNT
#   Transaction.amount       exact        DEBIT_AMOUNT (FT), AMOUNT_LOCAL_1 (TELLER)
#   Transaction.timestamp    approximate  DATE_TIME (YYMMDDHHMM string); PROCESSING_DATE is date only
#   Transaction.channel      approximate  TRANSACTION_TYPE codes (FT), TRANSACTION_CODE (TELLER = cash)
#   Account.open_date        approximate  OPENING_DATE (YYYYMMDD string)
#   Account.status           approximate  POSTING_RESTRICT code
#   Account.kyc_score        unmapped     (CUSTOMER.KYC_COMPLETE is YES/NO)
#   Person.kyc_verified_at   approximate  CUSTOMER.LAST_KYC_REVIEW_DATE (YYYYMMDD string)
#   Beneficiary.bank_identifier exact     BEN_BANK_SORT_CODE or BEN_BIC
#   account_under_investigation  approximate  ACCOUNT.POSTING_RESTRICT = 25 (a block, not a case)

CREATE GRAPH Bank_CoreT24 ()

USE GRAPH Bank_CoreT24
CREATE SCHEMA_CHANGE JOB setup_bank_core_t24 FOR GRAPH Bank_CoreT24 {
  ADD VERTEX COMPANY (PRIMARY_ID CO_CODE STRING, COMPANY_NAME STRING, LOCAL_CURRENCY STRING, LOCAL_COUNTRY STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX DEPT_ACCT_OFFICER (PRIMARY_ID DAO_ID INT, NAME STRING, DEPT_LEVEL STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX CUSTOMER (PRIMARY_ID CUSTOMER_NO INT, MNEMONIC STRING, SHORT_NAME STRING, NAME_1_HASH STRING, SECTOR INT, INDUSTRY INT, TARGET INT, NATIONALITY STRING, RESIDENCE STRING, DATE_OF_BIRTH STRING, LEGAL_ID_HASH STRING, LEGAL_DOC_NAME STRING, CUSTOMER_STATUS INT, KYC_COMPLETE STRING, LAST_KYC_REVIEW_DATE STRING, CALC_RISK_CLASS STRING, MANUAL_RISK_CLASS STRING, AML_CHECK STRING, AML_RESULT STRING, PHONE_1_HASH STRING, EMAIL_1_HASH STRING, RECORD_STATUS STRING, DATE_TIME STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX ACCOUNT (PRIMARY_ID ACCOUNT_NO STRING, CATEGORY INT, ACCOUNT_TITLE_1 STRING, CURRENCY STRING, OPENING_DATE STRING, POSTING_RESTRICT INT, WORKING_BALANCE DOUBLE, ONLINE_ACTUAL_BAL DOUBLE, LIMIT_REF STRING, RECORD_STATUS STRING, DATE_TIME STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX FUNDS_TRANSFER (PRIMARY_ID FT_REF STRING, TRANSACTION_TYPE STRING, DEBIT_CURRENCY STRING, DEBIT_AMOUNT DOUBLE, DEBIT_VALUE_DATE STRING, CREDIT_CURRENCY STRING, CREDIT_AMOUNT DOUBLE, CREDIT_VALUE_DATE STRING, PROCESSING_DATE STRING, ORDERING_CUST STRING, BEN_CUSTOMER_HASH STRING, BEN_ACCT_NO_HASH STRING, BEN_BANK STRING, PAYMENT_DETAILS STRING, CHARGES_ACCT_NO STRING, INPUTTER STRING, AUTHORISER STRING, RECORD_STATUS STRING, DATE_TIME STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX TELLER (PRIMARY_ID TT_REF STRING, TRANSACTION_CODE INT, DR_CR_MARKER STRING, CURRENCY_1 STRING, AMOUNT_LOCAL_1 DOUBLE, VALUE_DATE_1 STRING, TELLER_ID_1 STRING, NARRATIVE_1 STRING, RECORD_STATUS STRING, DATE_TIME STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX STMT_ENTRY (PRIMARY_ID STMT_ENTRY_ID STRING, AMOUNT_LCY DOUBLE, AMOUNT_FCY DOUBLE, TRANSACTION_CODE INT, BOOKING_DATE STRING, VALUE_DATE STRING, TRANS_REFERENCE STRING, SYSTEM_ID STRING, PRODUCT_CATEGORY INT) WITH primary_id_as_attribute="true";
  ADD VERTEX BENEFICIARY (PRIMARY_ID BEN_ID STRING, BEN_SHORT_NAME_HASH STRING, BEN_ACCT_NO_HASH STRING, BEN_BANK_SORT_CODE STRING, BEN_BIC STRING, BEN_COUNTRY STRING, TRANSACTION_TYPE STRING, DATE_TIME STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX CARD_ISSUE (PRIMARY_ID CARD_ISSUE_ID STRING, CARD_TYPE STRING, CARD_STATUS INT, PAN_LAST4_HASH STRING, ISSUE_DATE STRING, EXPIRY_DATE STRING, CANCELLATION_DATE STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX EB_EXTERNAL_USER (PRIMARY_ID EXT_USER_ID STRING, CHANNEL STRING, STATUS STRING, START_DATE STRING, END_DATE STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX PROTOCOL (PRIMARY_ID PROTOCOL_ID STRING, PROCESS_DATE STRING, TIME_MSECS STRING, TERMINAL_ID STRING, IP_ADDRESS STRING, APPLICATION STRING, LEVEL_FUNCTION STRING, REMARK STRING) WITH primary_id_as_attribute="true";

  ADD DIRECTED EDGE CUSTOMER_COMPANY (FROM CUSTOMER, TO COMPANY) WITH REVERSE_EDGE="reverse_CUSTOMER_COMPANY";
  ADD DIRECTED EDGE CUSTOMER_ACCOUNT_OFFICER (FROM CUSTOMER, TO DEPT_ACCT_OFFICER) WITH REVERSE_EDGE="reverse_CUSTOMER_ACCOUNT_OFFICER";
  ADD DIRECTED EDGE RELATION_CUSTOMER (FROM CUSTOMER, TO CUSTOMER, RELATION_CODE INT) WITH REVERSE_EDGE="reverse_RELATION_CUSTOMER";
  ADD DIRECTED EDGE ACCOUNT_CUSTOMER (FROM ACCOUNT, TO CUSTOMER) WITH REVERSE_EDGE="reverse_ACCOUNT_CUSTOMER";
  ADD DIRECTED EDGE JOINT_HOLDER (FROM ACCOUNT, TO CUSTOMER, RELATION_CODE INT, JOINT_NOTES STRING) WITH REVERSE_EDGE="reverse_JOINT_HOLDER";
  ADD DIRECTED EDGE ACCOUNT_COMPANY (FROM ACCOUNT, TO COMPANY) WITH REVERSE_EDGE="reverse_ACCOUNT_COMPANY";

  ADD DIRECTED EDGE FT_DEBIT_ACCT_NO (FROM FUNDS_TRANSFER, TO ACCOUNT) WITH REVERSE_EDGE="reverse_FT_DEBIT_ACCT_NO";
  ADD DIRECTED EDGE FT_CREDIT_ACCT_NO (FROM FUNDS_TRANSFER, TO ACCOUNT) WITH REVERSE_EDGE="reverse_FT_CREDIT_ACCT_NO";
  ADD DIRECTED EDGE FT_BENEFICIARY (FROM FUNDS_TRANSFER, TO BENEFICIARY) WITH REVERSE_EDGE="reverse_FT_BENEFICIARY";
  ADD DIRECTED EDGE FT_COMPANY (FROM FUNDS_TRANSFER, TO COMPANY) WITH REVERSE_EDGE="reverse_FT_COMPANY";
  ADD DIRECTED EDGE TT_ACCOUNT_1 (FROM TELLER, TO ACCOUNT) WITH REVERSE_EDGE="reverse_TT_ACCOUNT_1";
  ADD DIRECTED EDGE TT_COMPANY (FROM TELLER, TO COMPANY) WITH REVERSE_EDGE="reverse_TT_COMPANY";
  ADD DIRECTED EDGE STMT_ACCOUNT_NUMBER (FROM STMT_ENTRY, TO ACCOUNT) WITH REVERSE_EDGE="reverse_STMT_ACCOUNT_NUMBER";
  ADD DIRECTED EDGE STMT_TRANS_REFERENCE (FROM STMT_ENTRY, TO FUNDS_TRANSFER | FROM STMT_ENTRY, TO TELLER) WITH REVERSE_EDGE="reverse_STMT_TRANS_REFERENCE";

  ADD DIRECTED EDGE BENEFICIARY_OWNING_CUSTOMER (FROM BENEFICIARY, TO CUSTOMER) WITH REVERSE_EDGE="reverse_BENEFICIARY_OWNING_CUSTOMER";
  ADD DIRECTED EDGE CARD_ISSUE_ACCOUNT (FROM CARD_ISSUE, TO ACCOUNT) WITH REVERSE_EDGE="reverse_CARD_ISSUE_ACCOUNT";
  ADD DIRECTED EDGE EXT_USER_CUSTOMER (FROM EB_EXTERNAL_USER, TO CUSTOMER) WITH REVERSE_EDGE="reverse_EXT_USER_CUSTOMER";
  ADD DIRECTED EDGE PROTOCOL_USER (FROM PROTOCOL, TO EB_EXTERNAL_USER) WITH REVERSE_EDGE="reverse_PROTOCOL_USER";
}
RUN SCHEMA_CHANGE JOB setup_bank_core_t24
DROP JOB setup_bank_core_t24
